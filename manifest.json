{
  "name": "AGQuery Unblock",
  "version": "0.2.0",
  "manifest_version": 2,
  "description": "Automatic HTTPS block page for AdGuard Home: catches failed navigations, shows an Unblock page using your existing AGH session, and supports Unblock / Unblock for this client only.",
  "homepage_url": "https://github.com/tmiland/agquery-unblock",
  "browser_action": {
    "browser_style": true,
    "default_title": "AGQuery Unblock — settings"
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://192.168.1.1/*",
        "http://192.168.1.1:8088/*",
        "https://192.168.1.1:1443/*",
        "http://adguard.home.tmiland.com/*",
        "https://adguard.home.tmiland.com/*"
      ],
      "js": [
        "src/content.js",
        "src/api-bridge.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "blocked.html",
    "blocked.css",
    "blocked.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "agquery-unblock@tmiland.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
